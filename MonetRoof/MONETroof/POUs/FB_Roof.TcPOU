<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Roof" Id="{522d8680-feaf-4d00-ac9f-47554bf0503b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Roof
VAR_INPUT
	roof_number				: UINT;		// number of roof
	min_speed				: UINT;		// minimum speed to drive
	max_speed				: UINT;		// maximum speed to drive
	acceleration			: UINT;		// acceleration [speed/call]: the ramp time depends on the task cycle time (10 ms in all projects)
	min_position			: INT;		// minimum position of roof
	max_position			: INT;		// maximum position of roof
	max_position_diff		: INT;		// position difference between the two drives of the roof at which sync_error / limit_error trigger (smaller is tolerated)
	overtravel_margin		: INT := 10;	// stop if a drive counts more than this beyond min/max_position, e.g. with failed limit switches
	stall_timeout			: TIME := T#10S;	// stop if a drive is driven this long without a counter edge (see FB_RoofMotor)
	limit_slowdown			: REAL := 5;	// linear slowdown when moving towards limits starting at <x% and >(100-x)%
	comm					: I_Comm;
	reset_roof				: BOOL;

	slow_open				: BOOL := FALSE;	// open at min_speed, ignoring all errors and other commands
	slow_close				: BOOL := FALSE;	// close at min_speed, ignoring all errors and other commands
	
	zero_counter			: BOOL := FALSE;	// reset position counter of both motors to zero
END_VAR
VAR_OUTPUT
	sync_error				: BOOL;
	limit_error				: BOOL;
	overtravel_error		: BOOL;
	stall_error				: BOOL;
	drive_error				: BOOL;
	config_error			: BOOL;		// invalid parameters (speed / position range, max_position_diff, acceleration): the roof is held at 0
	state					: E_RoofState := E_RoofState.unknown;
	percent_open			: REAL;
	is_open					: BOOL;		// fully open (both open limit switches)
	is_closed				: BOOL;		// fully closed (both closed limit switches)
END_VAR
VAR_OUTPUT PERSISTENT
	position_valid			: BOOL;		// position counters are trustworthy: set by a limit snap, cleared by zero_counter and whenever the counters are lost
END_VAR
VAR
	// commands for roofs
	open_roof		AT%I*	: BOOL;
	close_roof		AT%I*	: BOOL;

	motors			: ARRAY[1..2] OF FB_RoofMotor;
	i				: UINT;
	
	roof_limit_open			: BOOL;		// whether any open limit switch for this roof is triggered
	roof_limit_closed		: BOOL;		// whether any close limit switch for this roof is triggered
	
	opened_event			: FB_EventLog;	// event for opened roof half
	closed_event			: FB_EventLog;	// event for closed roof half
	sync_error_event		: FB_EventLog;	// event for sync error
	limit_error_event		: FB_EventLog;	// event for limit error
	overtravel_error_event	: FB_EventLog;	// event for over-travel error
	stall_error_event		: FB_EventLog;	// event for stall error
	config_error_event		: FB_EventLog;	// event for configuration error
	
	// speed
	vel_ramp				: FB_Ramp;
	target_speed			: INT;	
	limit_speed				: REAL;
	speed					: INT;		// move speed
	
	// opening or closing?
	is_opening				: BOOL;		// move direction
	is_closing				: BOOL;	
	
	// boot-time snap guard
	bRoofInitialized		: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// parameters that would make the speed wrap in TO_INT / UINT arithmetic, divide by zero in percent_open,
// or leave the roof with a permanent sync error or without any ramp
config_error := max_speed > 32767 OR min_speed > max_speed OR max_position <= min_position OR
				max_position_diff <= 0 OR acceleration = 0;

// limit switches for this roof?
roof_limit_open   := motors[1].opened AND motors[2].opened;
roof_limit_closed := motors[1].closed AND motors[2].closed;

// ramp for roof velocity (percent_open below is still the value from the end of the previous cycle)
IF slow_open THEN
	speed := TO_INT(min_speed); 
ELSIF slow_close THEN
	speed := -TO_INT(min_speed);
ELSE
	vel_ramp(
		start		:= speed,
		target		:= target_speed,
		accel		:= acceleration,
		value		=> speed);
END_IF

// get direction
is_opening := speed > 0;
is_closing := speed < 0;

// slowdown near limits
IF is_closing AND percent_open < limit_slowdown THEN
	// closing near limit
	IF percent_open <= 0 THEN
		limit_speed := -TO_INT(min_speed);
	ELSE
		limit_speed := -((percent_open / limit_slowdown) * (max_speed - min_speed) + min_speed);
	END_IF
	IF limit_speed > speed THEN
		speed :=  REAL_TO_INT(MAX(limit_speed, -TO_INT(max_speed)));
	END_IF	
END_IF
IF is_opening AND 100.0 - percent_open < limit_slowdown THEN
	// opening near limit
	IF percent_open >= 100 THEN
		limit_speed := min_speed;
	ELSE
		limit_speed := ((100.0 - percent_open) / limit_slowdown) * (max_speed - min_speed) + min_speed;
	END_IF
	IF limit_speed < speed THEN
		speed := REAL_TO_INT(MIN(limit_speed, max_speed));
	END_IF	
END_IF

// stop on limit switches
IF (is_closing AND roof_limit_closed) OR (is_opening AND roof_limit_open) THEN
	Stop();
END_IF

// boot-time position snap: warm restart with the roof parked at a limit.
// One-shot on the first cycle, both sensors together (symmetric — no |diff|).
// Uses FB_Roof's own min_position/max_position, not motors[i].min_position/max_position: the
// latter are FB_RoofMotor's VAR_INPUTs, only assigned by the motor call further below, so on the
// very first cycle ever (before that call has run once) they are still 0.
IF NOT bRoofInitialized THEN
	bRoofInitialized := TRUE;
	// position_valid is PERSISTENT and may be stale: TwinCAT does not flush persistent data every
	// cycle, so an uncontrolled power loss mid-move can restore a value from before the roof's last
	// recorded position, with position_valid still TRUE from that earlier, once-valid state. Distrust
	// it unconditionally on every restart (clean or not, there is no way to tell them apart here) and
	// require it to be reconfirmed below, exactly like a lost/zeroed counter.
	position_valid := FALSE;
	IF roof_limit_closed THEN
		motors[1].SetPosition(min_position);
		motors[2].SetPosition(min_position);
		position_valid := TRUE;
	ELSIF roof_limit_open THEN
		motors[1].SetPosition(max_position);
		motors[2].SetPosition(max_position);
		position_valid := TRUE;
	END_IF
END_IF

// limit re-sync: snap both drives to the physical end position (both sensors
// engaged). Direction-gated: must NOT fire at the START of a move while the
// opposite limit switch is still engaged (the first counter edge can arrive
// ~0.5 s before the closed switch releases) — an ungated snap would erase
// those legitimate counts and leave the move one count short. While stalled
// against a limit the snap holds the position, so stall-jitter counts cannot
// drive it past the end position.
IF is_closing AND roof_limit_closed THEN
	motors[1].SetPosition(min_position);
	motors[2].SetPosition(min_position);
	position_valid := TRUE;
END_IF
IF is_opening AND roof_limit_open THEN
	motors[1].SetPosition(max_position);
	motors[2].SetPosition(max_position);
	position_valid := TRUE;
END_IF

// zeroing the counters says nothing about where the roof is
IF zero_counter THEN
	position_valid := FALSE;
END_IF

// latched error: hold the drive at 0 from the start of the cycle. Without this a level command
// (button held, open_roofs set) re-arms the ramp every cycle and the drive gets one ramp step
// (real_speed = acceleration) before the error stop below zeroes it again.
// Slow mode ignores errors on purpose, so it is exempted here explicitly: it must not depend
// on the motors being called before the error stop.
// A configuration error is not exempted: with invalid parameters the speed can wrap to the
// opposite direction, slow mode included.
IF config_error OR (state = E_RoofState.error AND NOT slow_open AND NOT slow_close) THEN
	Stop();
END_IF

// call motors
drive_error := FALSE;
FOR i := 1 TO 2 DO
	// call individual motors
	motors[i](
		roof_number 		:= roof_number,
		drive_number 		:= i,
		min_position 		:= min_position, 
		max_position 		:= max_position,
		real_speed			:= speed,
		zero_counter		:= zero_counter,
		stall_timeout		:= stall_timeout,
		comm 				:= comm);
		
	// check errors
	IF motors[i].error THEN
		drive_error := TRUE;
	END_IF
END_FOR
percent_open := (motors[1].percent_open + motors[2].percent_open) / 2.0;

// fully open/closed
is_open := roof_limit_open;
is_closed := roof_limit_closed;

// consistency check: no direction_error any more (removed) — the two motors of a roof half are
// always called with the same speed and are mechanically coupled by a shaft, so they can never
// disagree on direction; a mismatch between them can only ever show up as sync_error.
sync_error := ABS(motors[1].position - motors[2].position) >= max_position_diff;
limit_error := (is_opening AND motors[1].MovedSinceOpen >= max_position_diff) OR 
			   (is_closing AND motors[1].MovedSinceClosed >= max_position_diff) OR
			   (is_opening AND motors[2].MovedSinceOpen >= max_position_diff) OR 
			   (is_closing AND motors[2].MovedSinceClosed >= max_position_diff);

// no software end stop otherwise: with failed limit switches nothing bounds the travel.
// Only while the position is known: after lost/zeroed counters (e.g. a reset with the roof
// halfway open) it would block moving towards the end the counters wrongly claim to be at.
overtravel_error := position_valid AND
					((is_opening AND (motors[1].position > max_position + overtravel_margin OR 
									  motors[2].position > max_position + overtravel_margin)) OR
					 (is_closing AND (motors[1].position < min_position - overtravel_margin OR 
									  motors[2].position < min_position - overtravel_margin)));

// a drive that is driven but does not count (jam, ice, dead sensor)
stall_error := motors[1].stall_error OR motors[2].stall_error;

// stop on error
IF sync_error OR drive_error OR limit_error OR overtravel_error OR stall_error OR config_error OR state = E_RoofState.error THEN
	Stop();
END_IF

// set state
IF sync_error OR drive_error OR limit_error OR overtravel_error OR stall_error OR config_error THEN
	state := E_RoofState.error;
ELSE
	// no current error, but if we're still in error state, only proceed, if reset_roof is set
	IF state <> E_RoofState.error OR reset_roof THEN
		reset_roof := FALSE; 	

		// check other states
		// both motors get the same speed, so a moving roof has exactly one direction
		IF motors[1].moving OR motors[2].moving THEN
			IF motors[1].direction_open OR motors[2].direction_open THEN
				state := E_RoofState.opening;
			ELSE
				state := E_RoofState.closing;
			END_IF
		ELSIF roof_limit_open THEN
			// fully open needs both switches, like is_open; one switch alone is only 'stopped'
			state := E_RoofState.opened;
		ELSIF roof_limit_closed THEN
			state := E_RoofState.closed;
		ELSE
			state := E_RoofState.stopped;
		END_IF
	END_IF
END_IF

// events
opened_event(
	Trigger := is_open, 
	Level := ADSLOG_MSGTYPE_HINT, 
	FormatString := 'Roof #%s is fully open.', 
	OnMessage := UINT_TO_STRING(roof_number),
	Comm := comm);
closed_event(
	Trigger := is_closed, 
	Level := ADSLOG_MSGTYPE_HINT, 
	FormatString := 'Roof #%s is fully closed.', 
	OnMessage := UINT_TO_STRING(roof_number),
	Comm := comm); 

// errors
sync_error_event(
	Trigger := sync_error, 
	Level := ADSLOG_MSGTYPE_ERROR, 
	FormatString := 'Drives for roof #%s out of sync.', 
	OnMessage := UINT_TO_STRING(roof_number),
	Comm := comm); 
limit_error_event(
	Trigger := limit_error, 
	Level := ADSLOG_MSGTYPE_ERROR, 
	FormatString := 'Could not find 2nd limit switch for roof #%s.', 
	OnMessage := UINT_TO_STRING(roof_number),
	Comm := comm); 
overtravel_error_event(
	Trigger := overtravel_error, 
	Level := ADSLOG_MSGTYPE_ERROR, 
	FormatString := 'Roof #%s moved beyond its end position.', 
	OnMessage := UINT_TO_STRING(roof_number),
	Comm := comm); 
stall_error_event(
	Trigger := stall_error, 
	Level := ADSLOG_MSGTYPE_ERROR, 
	FormatString := 'Drive of roof #%s does not move (no counts).',
	OnMessage := UINT_TO_STRING(roof_number),
	Comm := comm);
config_error_event(
	Trigger := config_error,
	Level := ADSLOG_MSGTYPE_ERROR,
	FormatString := 'Roof #%s has invalid parameters.',
	OnMessage := UINT_TO_STRING(roof_number),
	Comm := comm); 	]]></ST>
    </Implementation>
    <Method Name="Automatic" Id="{dacfaaa5-2d6d-4b81-9dd2-47909b36b0e8}">
      <Declaration><![CDATA[METHOD Automatic : BOOL
VAR_INPUT
	open_roof	: BOOL;
	close_roof	: BOOL;
	stop_roof	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// automatic commands 
IF open_roof THEN
	Open();
ELSIF close_roof THEN
	Close();
ELSIF stop_roof THEN
	SoftStop();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Close" Id="{61d8273a-3637-4f75-891a-a676fd1df1ef}">
      <Declaration><![CDATA[METHOD Close : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT slow_open AND NOT slow_close THEN
	IF NOT is_closed THEN
		target_speed := -TO_INT(max_speed);
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Property Name="Error" Id="{2049fae4-dd42-4e2f-9cdb-cb25af6b6c0f}">
      <Declaration><![CDATA[PROPERTY Error : STRING]]></Declaration>
      <Get Name="Get" Id="{e1898dbd-a752-4774-92a7-5ab7716c886f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// invalid parameters come first, the other checks are meaningless with them;
// then a drive fault: it is usually the root cause of the stall or sync error that follows
IF config_error THEN
	Error := 'Configuration error';
ELSIF drive_error THEN
	Error := 'Drive error';
ELSIF sync_error THEN
	Error := 'Sync error';
ELSIF limit_error THEN
	Error := 'Limit error';
ELSIF overtravel_error THEN
	Error := 'Over-travel error';
ELSIF stall_error THEN
	Error := 'Stall error';
ELSE
	Error := '';
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Manual" Id="{8fd29956-6c66-4ec0-a43c-09228543d9c5}">
      <Declaration><![CDATA[METHOD Manual : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// manual commands commands
IF open_roof THEN
	Open();
ELSIF close_roof THEN
	Close();
ELSE
	SoftStop();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Open" Id="{a996c996-0ed0-4e45-8297-c49f0ce9e4f1}">
      <Declaration><![CDATA[METHOD Open : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT slow_open AND NOT slow_close THEN
	IF NOT is_open THEN
		target_speed := TO_INT(max_speed);
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{ceb23464-50f6-4143-8996-d8b438d9b575}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[reset_roof := TRUE;
FOR i := 1 TO 2 DO
	motors[i].Reset();
END_FOR;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SoftStop" Id="{ae8d7a4a-b701-4693-902f-f1904e5a7ece}">
      <Declaration><![CDATA[METHOD SoftStop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[target_speed := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Status" Id="{07bca3c5-c94b-4c22-9011-fec7df1eb29e}">
      <Declaration><![CDATA[PROPERTY Status : STRING]]></Declaration>
      <Get Name="Get" Id="{1d8c6644-bf1b-4508-9c70-6f96cf58d2ed}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF state = E_RoofState.closed THEN
	Status := 'CLOSED';
ELSIF state = E_RoofState.opened THEN
	Status := 'OPENED';
ELSIF state = E_RoofState.opening THEN
	Status := 'OPENING';
ELSIF state = E_RoofState.closing THEN
	Status := 'CLOSING';
ELSIF state = E_RoofState.stopped THEN
	Status := 'STOPPED';
ELSIF state = E_RoofState.error THEN
	Status := 'ERROR';
ELSIF state = E_RoofState.unknown THEN
	Status := 'UNKNOWN';	
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Stop" Id="{1f32f30b-7d83-4389-9405-dd9528b72d8a}">
      <Declaration><![CDATA[METHOD Stop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[speed := 0;
target_speed := 0;
]]></ST>
      </Implementation>
    </Method>
